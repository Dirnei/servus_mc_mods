---
/** Starlight's site title with the logo inlined into the page, so it does not reload on every page change. */
import logo from '../assets/servus-logo.png?inline';

const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title sl-flex">
	<img src={logo} alt="" width="32" height="32" />
	<span translate="no">{siteTitle}</span>
</a>

<style>
	.site-title {
		align-items: center;
		gap: var(--sl-nav-gap);
		font-family: var(--servus-font-heading);
		font-size: var(--sl-text-2xl);
		font-weight: 600;
		letter-spacing: -0.01em;
		color: var(--sl-color-white);
		text-decoration: none;
		white-space: nowrap;
		min-width: 0;
	}

	span {
		overflow: hidden;
	}

	img {
		flex: none;
	}
</style>
