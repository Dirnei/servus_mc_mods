---
/** The facts of one released mod: version, ids and what it needs, shown at the end of its page. */
interface Requirement {
	name: string;
	version: string;
	href?: string;
}

interface Props {
	version: string;
	modId: string;
	/** Project slug on CurseForge, as in curseforge.com/minecraft/mc-mods/<slug>. */
	curseforge: string;
	requires: Requirement[];
}

const { version, modId, curseforge, requires } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const releases = 'https://github.com/Dirnei/servus_mc_mods/releases/';
const project = `https://www.curseforge.com/minecraft/mc-mods/${curseforge}`;
const internal = (href: string) => href.startsWith('/');
---

<div class="mod-info not-content">
	<dl>
		<dt>Version</dt>
		<dd>{version}</dd>
		<dt>Mod id</dt>
		<dd><code>{modId}</code></dd>
		<dt>Minecraft</dt>
		<dd>26.1.2</dd>
		<dt>Requires</dt>
		<dd>
			<ul>
				<li>NeoForge 26.1.2.116 or newer</li>
				{requires.map((r) => (
					<li>
						{r.href ? (
							internal(r.href) ? <a href={base + r.href}>{r.name}</a> : <a href={r.href} target="_blank" rel="noopener">{r.name}</a>
						) : r.name}{' '}
						{r.version}
					</li>
				))}
			</ul>
		</dd>
		<dt>Download</dt>
		<dd>
			<ul>
				<li><a href={project} target="_blank" rel="noopener">CurseForge</a></li>
				<li><a href={releases} target="_blank" rel="noopener">GitHub releases</a></li>
			</ul>
		</dd>
	</dl>
</div>
