# Copy to .env and fill in. Names are Minecraft player names.
OPS=YourName
WHITELIST=YourName,HerName
ENABLE_WHITELIST=TRUE
MEMORY=4G
WEB_PORT=8095
# FALSE lets the dev client join; only on a trusted network
ONLINE_MODE=TRUE
# With ONLINE_MODE=FALSE leave OPS empty and run "op <name>" in the console after the
# player joined once; OPS resolves names at Mojang and stores the wrong UUID offline.
