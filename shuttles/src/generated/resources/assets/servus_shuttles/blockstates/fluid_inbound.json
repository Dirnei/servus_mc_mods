{
  "multipart": [
    {
      "apply": {
        "model": "servus_shuttles:block/fluid_station_tank"
      },
      "when": {
        "half": "lower"
      }
    },
    {
      "apply": {
        "model": "servus_shuttles:block/inbound_station"
      },
      "when": {
        "facing": "north",
        "half": "upper",
        "online": "false"
      }
    },
    {
      "apply": {
        "model": "servus_shuttles:block/inbound_station_idle"
      },
      "when": {
        "activity": "idle",
        "facing": "north",
        "half": "upper",
        "online": "true"
      }
    },
    {
      "apply": {
        "model": "servus_shuttles:block/inbound_station_working"
      },
      "when": {
        "activity": "working",
        "facing": "north",
        "half": "upper",
        "online": "true"
      }
    },
    {
      "apply": {
        "model": "servus_shuttles:block/inbound_station_blocked"
      },
      "when": {
        "activity": "blocked",
        "facing": "north",
        "half": "upper",
        "online": "true"
      }
    },
    {
      "apply": {
        "model": "servus_shuttles:block/inbound_station",
        "y": 90
      },
      "when": {
        "facing": "east",
        "half": "upper",
        "online": "false"
      }
    },
    {
      "apply": {
        "model": "servus_shuttles:block/inbound_station_idle",
        "y": 90
      },
      "when": {
        "activity": "idle",
        "facing": "east",
        "half": "upper",
        "online": "true"
      }
    },
    {
      "apply": {
        "model": "servus_shuttles:block/inbound_station_working",
        "y": 90
      },
      "when": {
        "activity": "working",
        "facing": "east",
        "half": "upper",
        "online": "true"
      }
    },
    {
      "apply": {
        "model": "servus_shuttles:block/inbound_station_blocked",
        "y": 90
      },
      "when": {
        "activity": "blocked",
        "facing": "east",
        "half": "upper",
        "online": "true"
      }
    },
    {
      "apply": {
        "model": "servus_shuttles:block/inbound_station",
        "y": 180
      },
      "when": {
        "facing": "south",
        "half": "upper",
        "online": "false"
      }
    },
    {
      "apply": {
        "model": "servus_shuttles:block/inbound_station_idle",
        "y": 180
      },
      "when": {
        "activity": "idle",
        "facing": "south",
        "half": "upper",
        "online": "true"
      }
    },
    {
      "apply": {
        "model": "servus_shuttles:block/inbound_station_working",
        "y": 180
      },
      "when": {
        "activity": "working",
        "facing": "south",
        "half": "upper",
        "online": "true"
      }
    },
    {
      "apply": {
        "model": "servus_shuttles:block/inbound_station_blocked",
        "y": 180
      },
      "when": {
        "activity": "blocked",
        "facing": "south",
        "half": "upper",
        "online": "true"
      }
    },
    {
      "apply": {
        "model": "servus_shuttles:block/inbound_station",
        "y": 270
      },
      "when": {
        "facing": "west",
        "half": "upper",
        "online": "false"
      }
    },
    {
      "apply": {
        "model": "servus_shuttles:block/inbound_station_idle",
        "y": 270
      },
      "when": {
        "activity": "idle",
        "facing": "west",
        "half": "upper",
        "online": "true"
      }
    },
    {
      "apply": {
        "model": "servus_shuttles:block/inbound_station_working",
        "y": 270
      },
      "when": {
        "activity": "working",
        "facing": "west",
        "half": "upper",
        "online": "true"
      }
    },
    {
      "apply": {
        "model": "servus_shuttles:block/inbound_station_blocked",
        "y": 270
      },
      "when": {
        "activity": "blocked",
        "facing": "west",
        "half": "upper",
        "online": "true"
      }
    }
  ]
}